---
// Reuse the landing site's actual document and visual source; do not maintain a second Terms copy.
import TermsOfService, { termsTitle, termsDescription } from '../../../../../../aside-react/src/legal/TermsOfService.jsx';
import '../../../../../../aside-react/src/styles.css';
import { legalDetails, legalReady, LEGAL_VERSION } from '../legal/config';
// Keep the shared header, using only routes available on the current marketing host.
const siteLinks = {
  home: 'https://recordly.dev/',
  blog: 'https://recordly.dev/blog',
  features: 'https://recordly.dev/#core-features',
  pricing: null,
};
const publication = { details: legalDetails, ready: legalReady, version: LEGAL_VERSION };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{termsTitle} · Recordly</title>
    <meta name="description" content={termsDescription} />
    <meta name="robots" content={legalReady ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="canonical" href="https://videos.recordly.dev/terms" />
  </head>
  <body>
    <TermsOfService publication={publication} siteLinks={siteLinks} client:load />
  </body>
</html>
