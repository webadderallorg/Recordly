# Public client configuration. Never put a Supabase service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Routes a browser sign-in back to the window that started it when several
# Recordly instances run. Supabase's redirect allow list must accept the
# sb_flow_id query on every return URL (see docs/authentication.md). Requires the
# OS-encrypted desktop auth store. Set false for projects without those entries.
VITE_OAUTH_FLOW_ID_REDIRECTS=true

# Leave blank until the hosted recording service is deployed and verified.
# Development defaults to localhost:8787; packaged builds require an explicit URL.
VITE_CLOUD_SHARE_ENDPOINT=
